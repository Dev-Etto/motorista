{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@application/*": [
        "./src/application/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@domain/*": [
        "./src/domain/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@modules/*": [
        "./modules/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "dist"
  ]
}
